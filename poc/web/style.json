{
  "version": 8,
  "name": "CFHydromet POC Style - Fixed",
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "protomaps": {
      "type": "vector",
      "tiles": [
        "http://localhost:8080/labatt_basemap_test/{z}/{x}/{y}.mvt"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "\u00a9 OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f3f1e8"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#f3f1e8"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e6eadf",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": "#75b8c8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.4,
          10,
          0.8,
          14,
          1.5
        ]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "highway",
          "major_road"
        ],
        false,
        true
      ],
      "paint": {
        "line-color": "#d2d2d2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.4,
          10,
          1.0,
          14,
          2.0
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "highway",
          "major_road"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#8b8b8b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.8,
          10,
          1.8,
          14,
          3.4
        ]
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 4,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          11,
          8,
          13,
          12,
          15
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#3d4548",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    }
  ]
}